    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@lucide/vue": "^1.33.0",
    "@pinia/testing": "^2.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "clsx": "^2.1.1",
