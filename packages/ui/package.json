{
  "name": "@spa/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3101",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --port 3101",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@sentry/vue": "^10.61.0",
    "@spa/shared": "workspace:*",
    "axios": "^1.7.0",
    "chart.js": "^4.5.1",
    "pinia": "^2.2.0",
    "vue": "^3.5.0",
    "vue-chartjs": "^5.3.3",
    "vue-router": "^4.4.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@lucide/vue": "^1.21.0",
    "@pinia/testing": "^1.0.3",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.1",
    "@vitejs/plugin-vue": "^5.1.0",
    "@vue/test-utils": "^2.4.11",
    "clsx": "^2.1.1",
    "jsdom": "^29.1.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.1.0"
  }
}
