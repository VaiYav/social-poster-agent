{
  "name": "@spa/backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "nest dev",
    "build": "nest build",
    "start": "nest start",
    "start:prod": "node dist/main.js",
    "lint": "oxlint src/",
    "format": "oxfmt 'src/**/*.ts' 'tests/**/*.ts'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:system": "vitest run tests/system",
    "test:acceptance": "vitest run tests/acceptance",
    "test:e2e": "vitest run tests/e2e",
    "test:coverage": "vitest run --coverage",
    "test:infra:up": "docker compose -f ../../infra/docker-compose.test.yml up -d",
    "test:infra:down": "docker compose -f ../../infra/docker-compose.test.yml down -v",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "dry-run": "nest build && node dist/dry-run/cli.js",
    "live": "tsc -p tsconfig.build.json && node dist/dry-run/live-run.cli.js",
    "test:discord": "tsc -p tsconfig.build.json && node --env-file=../../.env dist/dry-run/test-discord.cli.js",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@langchain/core": "^0.3.0",
    "@langchain/langgraph": "^0.2.0",
    "@langchain/langgraph-checkpoint": "^0.0.18",
    "@langchain/openai": "^0.4.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@prisma/client": "^6.0.0",
    "@resvg/resvg-js": "^2.6.2",
    "@sentry/nestjs": "^10.62.0",
    "@sentry/profiling-node": "^10.62.0",
    "@spa/shared": "workspace:*",
    "bullmq": "^5.0.0",
    "camoufox-js": "^0.11.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cron": "^4.4.0",
    "gray-matter": "^4.0.3",
    "imapflow": "^1.4.3",
    "ioredis": "^5.0.0",
    "joi": "^18.2.3",
    "nestjs-cls": "^6.2.1",
    "playwright-core": "^1.49.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "satori": "^0.26.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^2.0.0",
    "oxlint": "^1.0.0",
    "prisma": "^6.0.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.0",
    "typescript": "^5.7.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
