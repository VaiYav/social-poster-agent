{
  "name": "@spa/backend",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "description": "NestJS backend for the Social Poster Agent monorepo",
  "type": "commonjs",
  "scripts": {
    "dev": "nest dev",
    "build": "nest build",
    "start": "nest start",
    "start:prod": "node dist/main.js",
    "lint": "oxlint src/",
    "format": "oxfmt 'src/**/*.ts' 'tests/**/*.ts'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:system": "vitest run tests/system",
    "test:acceptance": "vitest run tests/acceptance",
    "test:e2e": "vitest run tests/e2e",
    "test:coverage": "vitest run --coverage",
    "test:infra:up": "docker compose -f ../../infra/docker-compose.test.yml up -d",
    "test:infra:down": "docker compose -f ../../infra/docker-compose.test.yml down -v",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "prompts:diff": "tsx --env-file=../../.env scripts/prompt-diff.ts",
    "queue:audit": "tsx --env-file=../../.env scripts/queue-triage-audit.ts",
    "queue:audit:json": "tsx --env-file=../../.env scripts/queue-triage-audit.ts --json",
    "cli": "tsx --env-file=../../.env src/cli.ts",
    "dry-run": "nest build && node dist/dry-run/cli.js",
    "live": "tsc -p tsconfig.build.json && node dist/dry-run/live-run.cli.js",
    "test:discord": "tsc -p tsconfig.build.json && node --env-file=../../.env dist/dry-run/test-discord.cli.js",
    "postinstall": "prisma generate && node scripts/patch-playwright.js"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.12",
    "@langchain/langgraph-checkpoint": "^1.1.5",
    "@langchain/openai": "^1.5.10",
    "@langfuse/client": "^5.10.1",
    "@langfuse/langchain": "^5.10.1",
    "@langfuse/otel": "^5.10.1",
    "@langfuse/tracing": "^5.10.1",
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.1",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.7",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@resvg/resvg-js": "^2.6.2",
    "@sentry/nestjs": "^10.70.0",
    "@sentry/profiling-node": "^10.70.0",
    "@spa/shared": "workspace:*",
    "bullmq": "^6.2.0",
    "camoufox-js": "^0.12.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cron": "^4.4.0",
    "dotenv": "^17.4.2",
    "fast-xml-parser": "5.11.0",
    "gray-matter": "^4.0.3",
    "imapflow": "^1.7.1",
    "ioredis": "^6.0.0",
    "joi": "^18.2.5",
    "nestjs-cls": "^6.2.1",
    "pg": "^8.23.0",
    "playwright-core": "~1.60.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "satori": "^0.33.1",
    "tinyld": "^1.3.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.11",
    "diff": "^9.0.0",
    "oxlint": "^1.79.0",
    "prisma": "^7.9.1",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsx": "4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  }
}
