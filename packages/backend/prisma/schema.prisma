// Social Poster Agent — Prisma schema
// See CONSTITUTION.md §7 for domain model

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Enums
// ============================================================

enum SocialNetwork {
  X
  THREADS
  FACEBOOK
  // ── Syndication platforms (Phase 1-4) ──
  DEVTO          // Phase 1: Dev.to (Camoufox)
  HASHNODE       // Phase 1: Hashnode (Camoufox)
  LINKEDIN       // Phase 1: LinkedIn (Camoufox)
  BLUESKY        // Phase 2: Bluesky (Camoufox)
  MASTODON       // Phase 2: Mastodon (Camoufox)
  TELEGRAM       // Phase 2: Telegram (Bot API — only API exception)
  MEDIUM         // Phase 3: Medium (Camoufox)
  SUBSTACK       // Phase 3: Substack (Camoufox)
  REDDIT         // Phase 4: Reddit (Camoufox — participation)
  QUORA          // Phase 4: Quora (Camoufox — participation)
  PINTEREST      // Phase 4: Pinterest (Camoufox)
}

enum PostStatus {
  DRAFT
  APPROVED
  POSTING
  POSTED
  FAILED
  REJECTED
  // ── Syndication statuses ──
  JUDGED    // Article/social post evaluated by LLM-as-a-Judge, awaiting auto-approve decision
  VERIFIED  // Post published AND verified on platform (POST_VERIFIED event emitted)
}

// ContentType — distinguishes social posts from articles from participation answers
enum ContentType {
  SOCIAL_POST   // Short social post (X, Threads, Facebook, LinkedIn, Bluesky, Mastodon, Telegram)
  ARTICLE       // Long-form article (Dev.to, Hashnode, Medium, Substack)
  ANSWER        // Participation answer (Reddit, Quora)
  PIN           // Pinterest pin
}

enum SessionStatus {
  ACTIVE
  EXPIRED
  ERROR
  WARMUP    // F20: new account in warm-up phase (browse-only, gradual ramp)
  BANNED    // F21: account flagged as banned by health monitor
}

enum GenerationRunStatus {
  RUNNING
  COMPLETED
  FAILED
  PAUSED
}

enum GenerationTrigger {
  CRON
  MANUAL
  AUTONOMOUS
}

// ============================================================
// Engagement Enums (Phase 2-3)
// ============================================================

enum InteractionType {
  LIKE
  COMMENT
  FOLLOW
  UNFOLLOW
  REPLY
  REPOST
  QUOTE
  SCROLL_VIEW
}

enum InteractionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  SKIPPED
}

enum BrowsingSessionStatus {
  ACTIVE
  COMPLETED
  FAILED
  ABORTED
}

// ContentSourceType — not a Prisma enum, stored as lowercase string in
// Post.sourceRef JSON field: { type: 'brief'|'article'|'topic'|'create_run', ... }
// Canonical types in packages/shared/src/types/enums.ts

model AccountGroup {
  id                 String    @id @default(uuid())
  name               String
  proxyUrl           String?
  timezone           String?
  fingerprintProfile Json?
  accounts           SocialAccount[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model SocialAccount {
  id              String         @id @default(uuid())
  network         SocialNetwork
  handle          String
  displayName     String?        // human label, e.g. "Soulwise US"
  priority        Int            @default(0)
  groupId         String?
  group           AccountGroup?  @relation(fields: [groupId], references: [id], onDelete: SetNull)
  fingerprintSeed String?        // optional deterministic seed override
  proxyUrl        String?        // optional per-account proxy override
  credentialsRef  String         // comma-separated env var names (never the password itself)
  active          Boolean        @default(true)
  // F20: Warm-up mode for new accounts (browse-only → gradual ramp)
  warmupEnabled   Boolean        @default(false) // true = account in warm-up phase
  warmupStartedAt DateTime?      // when warm-up started (for gradual ramp calculation)
  warmupDaysTotal Int            @default(7)     // total warm-up days (default 7)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  sessions        Session[]
  posts           Post[]
  threads         PostThread[]
  interactions    Interaction[]
  browsingSessions BrowsingSession[]

  @@unique([network, handle])
  @@index([network])
  @@index([priority])
  @@index([groupId])
}

model Session {
  id              String         @id @default(uuid())
  accountId       String
  account         SocialAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  storageState    Json           // Playwright storageState (cookies, localStorage)
  status          SessionStatus  @default(ACTIVE)
  lastHealthCheck DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([accountId])
  @@index([status])
}

model GenerationRun {
  id            String                 @id @default(uuid())
  triggeredBy   GenerationTrigger
  sourceTopics  Json                   // array of topics from content-source
  status        GenerationRunStatus    @default(RUNNING)
  startedAt     DateTime               @default(now())
  completedAt   DateTime?
  posts         Post[]
  errorMessage  String?

  @@index([status])
  @@index([triggeredBy])
}

// ============================================================
// Topic — LLM-generated content topics (replaces CAP repo dependency)
// Generated by TopicGenerationService cron, consumed by DbContentReader.
// ============================================================

model Topic {
  id          String   @id @default(uuid())
  topic       String   @unique
  keywords    Json     // string[]
  facts       Json     // string[]
  category    String   @default("general")
  sourceType  String   @default("llm") // "llm" | "trending" | "manual"
  status      String   @default("active") // "active" | "used" | "archived"
  usedAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([category])
  @@index([createdAt])
}

// ============================================================
// Content sources — configurable input adapters for IContentPort
// ============================================================

model ContentSource {
  id          String   @id @default(uuid())
  sourceType  String   // "cap_file", "db", "rss", "api", "google_trends"
  name        String?
  enabled     Boolean  @default(true)
  priority    Int      @default(0)
  config      Json     // adapter-specific config (Record<string, unknown>)
  lastRunAt   DateTime?
  lastError   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([enabled])
  @@index([priority])
}

model PostThread {
  id         String       @id @default(uuid())
  accountId  String
  account    SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  status     PostStatus   @default(DRAFT)
  posts      Post[]
  createdAt  DateTime     @default(now())
  postedAt   DateTime?

  @@index([accountId])
  @@index([status])
}

// ============================================================
// Thread Progress — per-reply tracking for resumable threads (P0-H2)
// ============================================================

model ThreadProgress {
  id           String    @id @default(uuid())
  postId       String    // FK → Post (root post of the thread)
  replyPostId  String    // FK → Post (individual reply)
  position     Int       // threadPosition of the reply (1, 2, 3, ...)
  status       String    // PENDING | POSTED | FAILED
  postUrl      String?   // URL of the individual reply (if posted)
  attemptedAt  DateTime  @default(now())
  completedAt  DateTime?
  error        String?

  @@unique([postId, replyPostId])
  @@index([postId])
  @@index([status])
}

model Post {
  id               String           @id @default(uuid())
  generationRunId  String?
  generationRun    GenerationRun?   @relation(fields: [generationRunId], references: [id], onDelete: SetNull)
  accountId        String
  account          SocialAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  threadId         String?
  thread           PostThread?      @relation(fields: [threadId], references: [id], onDelete: SetNull)
  threadPosition   Int              @default(0) // 0 = root, 1+ = replies in thread
  network          SocialNetwork
  language         String           @default("en") // ISO 639-1: en, ru, uk, es, it
  content          String           // final post text
  sourceRef        Json?            // { type: 'brief'|'article'|'topic', path: '...', topic: '...' }
  sourcePath       String?          // extracted sourceRef.path for indexed queries
  status           PostStatus       @default(DRAFT)
  postUrl          String?          // URL after posting
  errorMessage     String?
  retryCount       Int              @default(0) // BullMQ retry count (0-3)
  llmMetadata      Json?            // { model, tokens, cost, promptVersion, angleType }
  simhash          String?          // Sprint L: precomputed SimHash for fast dedup
  // ── Syndication fields (Phase 0-1) ──
  contentType      ContentType      @default(SOCIAL_POST) // SOCIAL_POST | ARTICLE | ANSWER | PIN
  canonicalUrl     String?          // POSSE canonical URL (blog URL for articles)
  syndicatedUrls   Json?            // { [network: string]: string } — platform URLs after syndication
  judgeScores      Json?            // LLM-as-a-Judge scores { anti_ai_tone, hook_strength, factual_accuracy, ... }
  judgeRetried     Boolean          @default(false) // true if judge triggered a refine retry
  createdAt        DateTime         @default(now())
  approvedAt       DateTime?
  postedAt         DateTime?
  metrics          PostMetrics[]    @relation("PostMetricsToPost")
  incomingComments IncomingComment[] @relation("PostIncomingComments") // Sprint Q: tracked comments for reply monitoring
  variants         PostVariant[]

  @@index([status])
  @@index([network])
  @@index([accountId])
  @@index([generationRunId])
  @@index([threadId])
  @@index([simhash])
  @@index([sourcePath, network])
  @@index([contentType])
  @@index([canonicalUrl])
}

// A/B testing: variants generated for a post and their real-world outcomes.
model PostVariant {
  id          String        @id @default(uuid())
  postId      String
  post        Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  network     SocialNetwork
  label       String        // e.g. 'a', 'b', 'base', 'default', 'custom'
  content     String        // variant text
  judgeScores Json?         // LLM-as-a-Judge scores from the generation run
  selected    Boolean       @default(false)
  postedAt    DateTime?
  metricsAt   DateTime?
  likes       Int?
  comments    Int?
  shares      Int?
  impressions Int?
  createdAt   DateTime      @default(now())

  @@index([postId, network])
  @@index([network, selected, postedAt])
}

// ============================================================
// Post Metrics — F6: engagement metrics scraping (likes, comments, shares)
// ============================================================

model PostMetrics {
  id          String   @id @default(uuid())
  postId      String
  post            Post            @relation("PostMetricsToPost", fields: [postId], references: [id], onDelete: Cascade)
  network     SocialNetwork
  likes       Int      @default(0)
  comments    Int      @default(0)
  shares      Int      @default(0)
  impressions Int?
  collectedAt DateTime @default(now())

  @@index([postId, collectedAt])
  @@index([network])
}

// ============================================================
// Engagement Models (Phase 2-3)
// ============================================================

model Interaction {
  id            String             @id @default(uuid())
  accountId     String
  account       SocialAccount      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type          InteractionType
  status        InteractionStatus  @default(PENDING)
  targetUrl     String?            // URL of the post being liked/commented/replied to
  targetHandle  String?            // handle of the account being followed/interacted with
  content       String?            // comment text (for COMMENT/REPLY)
  errorMessage  String?
  screenshotPath String?           // screenshot for debugging
  browsingSessionId String?
  browsingSession  BrowsingSession? @relation(fields: [browsingSessionId], references: [id], onDelete: SetNull)
  createdAt     DateTime           @default(now())
  completedAt   DateTime?

  @@index([accountId])
  @@index([type])
  @@index([status])
  @@index([browsingSessionId])
  @@index([createdAt])
}

/// Sprint Q / F4: Incoming comments on our posts, tracked for automated reply monitoring.
/// Conversation threads: nested replies are linked via parentId and grouped by conversationId (root commentId).
model IncomingComment {
  id                String           @id @default(uuid())
  postId            String
  post              Post             @relation("PostIncomingComments", fields: [postId], references: [id], onDelete: Cascade)
  network           SocialNetwork
  commentId         String           // platform-specific comment ID (for dedup)
  author            String
  text              String
  authorProfileUrl  String?
  commentUrl        String?          // platform permalink of this comment/tweet
  parentId          String?          // DB id of parent comment (nested reply)
  parent            IncomingComment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  children          IncomingComment[] @relation("CommentReplies")
  conversationId    String?          // root commentId of the conversation thread
  depth             Int              @default(0) // number of agent replies in this chain
  isQuestion        Boolean          @default(false)
  questionConfidence Float?          // classifier confidence 0..1
  questionType      String?          // factual | opinion | personal | offtopic
  replyUrl          String?          // URL of our posted reply on the platform (for nested reply scraping)
  status            CommentStatus    @default(NEW)
  replyText         String?          // generated reply (if any)
  replyPostedAt     DateTime?
  needsHumanReview  Boolean          @default(false) // true for complex/sensitive comments
  humanReviewReason String?         // why human review is needed
  scrapedAt         DateTime         @default(now())
  createdAt         DateTime         @default(now())

  @@unique([postId, commentId]) // dedup: one record per (post, comment)
  @@index([postId])
  @@index([status])
  @@index([network])
  @@index([scrapedAt])
  @@index([conversationId, depth])
  @@index([parentId])
}

enum CommentStatus {
  NEW            // just scraped, not yet processed
  REPLIED        // reply posted automatically
  SKIPPED        // decided not to reply (spam, self, etc.)
  HUMAN_REVIEW   // needs human review (complex, sensitive)
  REPLIED_MANUAL // human reviewed and replied manually
}

model BrowsingSession {
  id              String               @id @default(uuid())
  accountId       String
  account         SocialAccount        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  status          BrowsingSessionStatus @default(ACTIVE)
  startedAt       DateTime             @default(now())
  endedAt         DateTime?
  durationSec     Int                  @default(0)
  postsViewed     Int                  @default(0)
  interactionsCount Int                @default(0)
  feedUrl         String?              // which feed was browsed
  errorMessage    String?
  interactions    Interaction[]

  @@index([accountId])
  @@index([status])
  @@index([startedAt])
}

// ============================================================
// Admin — UI authentication (JWT in httpOnly cookie)
// Single admin account, bootstrapped from ADMIN_USERNAME/ADMIN_PASSWORD env vars.
// Password hashed with Node.js crypto.scrypt (no external deps).
// ============================================================

model Admin {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String   // scrypt hash: "saltHex:hashHex"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
