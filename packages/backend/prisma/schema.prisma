// Social Poster Agent — Prisma schema
// See CONSTITUTION.md §7 for domain model

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Enums
// ============================================================

enum SocialNetwork {
  X
  THREADS
  FACEBOOK
  // ── Syndication platforms (Phase 1-4) ──
  DEVTO          // Phase 1: Dev.to (Camoufox)
  HASHNODE       // Phase 1: Hashnode (Camoufox)
  LINKEDIN       // Phase 1: LinkedIn (Camoufox)
  BLUESKY        // Phase 2: Bluesky (Camoufox)
  MASTODON       // Phase 2: Mastodon (Camoufox)
  TELEGRAM       // Phase 2: Telegram (Bot API — only API exception)
  MEDIUM         // Phase 3: Medium (Camoufox)
  SUBSTACK       // Phase 3: Substack (Camoufox)
  REDDIT         // Phase 4: Reddit (Camoufox — participation)
  QUORA          // Phase 4: Quora (Camoufox — participation)
  PINTEREST      // Phase 4: Pinterest (Camoufox)
}

enum PostStatus {
  DRAFT
  APPROVED
  POSTING
  POSTED
  FAILED
  REJECTED
  // ── Syndication statuses ──
  JUDGED    // Article/social post evaluated by LLM-as-a-Judge, awaiting auto-approve decision
  VERIFIED  // Post published AND verified on platform (POST_VERIFIED event emitted)
}

// ContentType — distinguishes social posts from articles from participation answers
enum ContentType {
  SOCIAL_POST   // Short social post (X, Threads, Facebook, LinkedIn, Bluesky, Mastodon, Telegram)
  ARTICLE       // Long-form article (Dev.to, Hashnode, Medium, Substack)
  ANSWER        // Participation answer (Reddit, Quora)
  PIN           // Pinterest pin
}

enum SessionStatus {
  ACTIVE
  EXPIRED
  ERROR
  WARMUP    // F20: new account in warm-up phase (browse-only, gradual ramp)
  BANNED    // F21: account flagged as banned by health monitor
}

enum GenerationRunStatus {
  RUNNING
  COMPLETED
  FAILED
  PAUSED
}

enum GenerationTrigger {
  CRON
  MANUAL
  AUTONOMOUS
}

// ============================================================
// Engagement Enums (Phase 2-3)
// ============================================================

enum InteractionType {
  LIKE
  COMMENT
  FOLLOW
  UNFOLLOW
  REPLY
  REPOST
  QUOTE
  SCROLL_VIEW
}

enum InteractionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  SKIPPED
}

enum BrowsingSessionStatus {
  ACTIVE
  COMPLETED
  FAILED
  ABORTED
}

// ContentSourceType — not a Prisma enum, stored as lowercase string in
// Post.sourceRef JSON field: { type: 'brief'|'article'|'topic'|'create_run', ... }
// Canonical types in packages/shared/src/types/enums.ts

model AccountGroup {
  id                 String    @id @default(uuid())
  name               String
  proxyUrl           String?
  timezone           String?
  fingerprintProfile Json?
  accounts           SocialAccount[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model SocialAccount {
  id              String         @id @default(uuid())
  network         SocialNetwork
  handle          String
  displayName     String?        // human label, e.g. "Soulwise US"
  priority        Int            @default(0)
  groupId         String?
  group           AccountGroup?  @relation(fields: [groupId], references: [id], onDelete: SetNull)
  fingerprintSeed String?        // optional deterministic seed override
  proxyUrl        String?        // optional per-account proxy override
  credentialsRef  String         // comma-separated env var names (never the password itself)
  active          Boolean        @default(true)
  // M1.2: per-account settings overrides — validated by AccountSettingsSchema (@spa/shared).
  // Inheritance: hard defaults → global env → AccountGroup (future) → this JSON.
  settings        Json?
  // F20: Warm-up mode for new accounts (browse-only → gradual ramp)
  warmupEnabled   Boolean        @default(false) // true = account in warm-up phase
  warmupStartedAt DateTime?      // when warm-up started (for gradual ramp calculation)
  warmupDaysTotal Int            @default(7)     // total warm-up days (default 7)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  sessions        Session[]
  posts           Post[]
  threads         PostThread[]
  interactions    Interaction[]
  browsingSessions BrowsingSession[]
  personaAssignments AccountPersonaAssignment[]
  compiledExecutionPolicies CompiledExecutionPolicy[]
  engagementSuggestions EngagementSuggestion[]
  reputationStates AccountReputationState[]
  reputationSignals ReputationSignal[]
  reputationIncidents ReputationIncident[]
  editorialAssignments EditorialAssignmentRecord[]
  creatorRelationships CreatorRelationship[]

  @@unique([network, handle])
  @@index([network])
  @@index([priority])
  @@index([groupId])
}

model EditorialPersona {
  id          String   @id @default(uuid())
  key         String   @unique
  displayName String
  status      String   @default("DRAFT")
  revisions   PersonaRevision[]
  assignments AccountPersonaAssignment[]
  memories    PersonaMemory[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PersonaRevision {
  id                  String   @id @default(uuid())
  personaId           String
  persona             EditorialPersona @relation(fields: [personaId], references: [id], onDelete: Cascade)
  version             Int
  profile             Json
  checksum            String
  safetyPolicyVersion String
  createdBy           String?
  createdAt           DateTime @default(now())
  assignments         AccountPersonaAssignment[]
  posts               Post[]
  engagementSuggestions EngagementSuggestion[]
  editorialAssignments EditorialAssignmentRecord[]
  creatorRelationships CreatorRelationship[]

  @@unique([personaId, version])
  @@unique([personaId, checksum])
  @@index([personaId, createdAt])
}

model AccountPersonaAssignment {
  id                String   @id @default(uuid())
  accountId         String
  account           SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  personaId         String
  persona           EditorialPersona @relation(fields: [personaId], references: [id], onDelete: Restrict)
  personaRevisionId String
  personaRevision   PersonaRevision @relation(fields: [personaRevisionId], references: [id], onDelete: Restrict)
  defaultVoiceMode  String
  active            Boolean  @default(true)
  startsAt          DateTime @default(now())
  endsAt            DateTime?

  @@index([accountId, active])
  @@index([personaId, startsAt])
}

// ADR-012: versioned, human-approved policy evidence and compiled runtime
// decisions. Statuses are intentionally strings so policy lifecycle additions
// do not require a database enum migration.
model PlatformPolicyEvidence {
  id           String   @id @default(uuid())
  network      SocialNetwork
  sourceUrl    String
  sourceType   String
  contentHash  String
  snapshotRef  String?
  fetchedAt    DateTime @default(now())
  verifiedAt   DateTime?
  expiresAt    DateTime?
  status       String   @default("DRAFT")
  reviewer     String?
  reviewNotes  String?
  createdAt    DateTime @default(now())
  versions     PlatformActionPolicy[]

  @@unique([sourceUrl, contentHash])
  @@index([network, status, expiresAt])
}

model PlatformActionPolicy {
  id                 String   @id @default(uuid())
  policyKey          String
  version            Int
  network            SocialNetwork
  action             String
  transport          String
  targetRelationship String
  executionMode      String
  requirements       Json
  limits             Json?
  evidenceId         String
  evidence           PlatformPolicyEvidence @relation(fields: [evidenceId], references: [id], onDelete: Restrict)
  status             String   @default("DRAFT")
  effectiveAt        DateTime?
  expiresAt          DateTime?
  approvedBy         String?
  approvedAt         DateTime?
  supersedesId       String?
  createdAt          DateTime @default(now())

  @@unique([policyKey, version])
  @@index([network, action, status])
  @@index([expiresAt])
}

model CompiledExecutionPolicy {
  id              String   @id @default(uuid())
  accountId       String?
  account         SocialAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  network         SocialNetwork
  action          String
  contextClass    String
  executionMode   String
  sourcePolicyIds Json
  reputationState String
  policyHash      String
  validUntil      DateTime
  createdAt       DateTime @default(now())

  @@unique([accountId, network, action, contextClass, policyHash])
  @@index([accountId, network, action])
}

// ADR-012: reputation is a separate state machine from technical health and
// policy evidence. Signals are immutable facts; state transitions are audited.
model AccountReputationState {
  id          String   @id @default(uuid())
  accountId   String
  account     SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  network     SocialNetwork
  state       String   @default("HEALTHY")
  version     Int      @default(1)
  reason      String?
  changedAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([accountId, network])
  @@index([state, updatedAt])
}

model ReputationSignal {
  id           String   @id @default(uuid())
  accountId    String
  account      SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  network      SocialNetwork
  signalType   String
  signalFamily String
  severity     String
  trustLevel   String
  sourceRef    Json
  evidenceHash String
  classification Json?
  occurredAt   DateTime
  expiresAt    DateTime?
  createdAt    DateTime @default(now())

  @@unique([accountId, network, signalType, evidenceHash])
  @@index([accountId, network, occurredAt])
  @@index([signalFamily, severity])
}

model ReputationIncident {
  id               String   @id @default(uuid())
  accountId        String
  account          SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  network          SocialNetwork
  status           String
  stateBefore     String
  stateAfter      String
  severity        String
  signalIds       Json
  decisionRules   Json
  automaticActions Json
  operatorActions Json?
  owner           String?
  acknowledgedAt  DateTime?
  resolvedAt      DateTime?
  recoveryPlan    Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([accountId, network, status])
  @@index([severity, createdAt])
}

// ADR-008: deterministic cross-account portfolio planning. These records
// explain why an opportunity was assigned, deferred or skipped.
model EditorialOpportunity {
  id             String   @id @default(uuid())
  sourceType     String
  sourceRef      Json
  domain         String
  canonicalTopic String
  thesisHash     String
  riskTier       String
  funnelIntent   String
  validFrom      DateTime?
  validUntil     DateTime?
  status         String   @default("OPEN")
  createdAt      DateTime @default(now())
  assignments    EditorialAssignmentRecord[]

  @@index([status, validUntil])
  @@index([domain, createdAt])
  @@index([thesisHash])
}

model EditorialAssignmentRecord {
  id                     String   @id @default(uuid())
  opportunityId          String
  opportunity            EditorialOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  accountId              String?
  account                SocialAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  personaRevisionId      String?
  personaRevision        PersonaRevision? @relation(fields: [personaRevisionId], references: [id], onDelete: SetNull)
  action                 String
  thesis                 String
  thesisHash             String
  angle                  String
  voiceMode              String?
  funnelIntent           String
  scoreComponents        Json
  constraintResults      Json
  status                 String   @default("PLANNED")
  experimentAssignmentId String?
  validUntil             DateTime
  createdAt              DateTime @default(now())

  @@index([accountId, status, createdAt])
  @@index([personaRevisionId, createdAt])
  @@index([thesisHash, createdAt])
}

model PersonaMemory {
  id             String   @id @default(uuid())
  personaId      String
  persona        EditorialPersona @relation(fields: [personaId], references: [id], onDelete: Cascade)
  kind           String
  text           String
  sourceType     String
  sourceRef      Json?
  status         String   @default("CANDIDATE")
  reviewedBy     String?
  confidence     Float?
  importance     Float    @default(0.5)
  occurredAt     DateTime?
  validFrom      DateTime?
  validTo        DateTime?
  expiresAt      DateTime?
  contentHash    String
  embeddingModel String?
  lastUsedAt     DateTime?
  usageCount     Int      @default(0)
  supersededById String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([personaId, kind, contentHash])
  @@index([personaId, status, kind])
  @@index([expiresAt])
}

model KnowledgeEvidence {
  id           String   @id @default(uuid())
  domain       String
  riskClass    String
  title        String
  text         String
  sourceUrl    String?
  sourceType   String
  reviewStatus String   @default("NEEDS_REVIEW")
  reviewedBy   String?
  reviewedAt   DateTime?
  validFrom    DateTime?
  validTo      DateTime?
  contentHash  String   @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([domain, reviewStatus])
  @@index([validTo])
}

// COST-001: durable, secret-free accounting for every provider attempt.
model LlmUsageEvent {
  id          String   @id @default(uuid())
  accountId   String?
  postId      String?
  runId       String?
  provider    String
  model       String
  role        String
  tokensIn    Int      @default(0)
  tokensOut   Int      @default(0)
  costUsd     Decimal  @db.Decimal(10, 6)
  cached      Boolean  @default(false)
  durationMs  Int?
  outcome     String
  costSource  String
  createdAt   DateTime @default(now())

  @@index([accountId, createdAt])
  @@index([runId])
  @@index([role, createdAt])
}

model AudienceSignal {
  id                 String   @id @default(uuid())
  sourceType         String
  sourceRef          Json
  network            SocialNetwork
  accountId          String?
  personaRevisionId  String?
  signalType         String
  domain             String
  normalizedQuestion String
  languagePattern    String?
  extractedClaims    Json?
  riskTier           String
  privacyStatus      String   @default("ELIGIBLE")
  sourceAuthorHash   String?
  sourceSnapshotHash String
  occurredAt         DateTime
  expiresAt          DateTime?
  createdAt          DateTime @default(now())
  memberships        AudienceClusterMembership[]

  @@unique([network, sourceSnapshotHash, signalType])
  @@index([domain, signalType, occurredAt])
  @@index([privacyStatus, expiresAt])
}

model AudienceQuestionCluster {
  id                   String   @id @default(uuid())
  clusterKey           String   @unique
  label                String
  canonicalQuestion    String
  domain               String
  signalTypes          Json
  riskTier             String
  status               String   @default("NEW")
  sourceCount          Int      @default(0)
  distinctAuthorCount  Int      @default(0)
  firstSeenAt          DateTime
  lastSeenAt           DateTime
  demandScore          Float    @default(0)
  scoreComponents      Json
  answerState          Json?
  linkedTopicId        String?
  reviewedBy           String?
  reviewedAt           DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  memberships          AudienceClusterMembership[]
  insights             ProductInsightProposal[]

  @@index([status, demandScore])
  @@index([domain, lastSeenAt])
}

model AudienceClusterMembership {
  clusterId  String
  signalId   String
  similarity Float?
  method     String
  createdAt  DateTime @default(now())
  cluster    AudienceQuestionCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  signal     AudienceSignal @relation(fields: [signalId], references: [id], onDelete: Cascade)

  @@id([clusterId, signalId])
  @@index([signalId])
}

model ProductInsightProposal {
  id             String   @id @default(uuid())
  clusterId      String
  cluster        AudienceQuestionCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  insightType    String
  summary        String
  evidence       Json
  privacyReview  String
  status         String   @default("DRAFT")
  destinationRef String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, createdAt])
  @@index([clusterId])
}

model CreatorProfile {
  id                  String   @id @default(uuid())
  network             SocialNetwork
  handleCanonical     String
  handleHash          String
  displayName         String?
  profileUrl          String
  publicTopics        Json
  status              String   @default("ACTIVE")
  sourceRefs          Json
  lastVerifiedAt      DateTime?
  rawProfileExpiresAt DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  relationships         CreatorRelationship[]
  outgoingIdentityLinks CreatorIdentityLink[] @relation("CreatorIdentityLinkSource")
  incomingIdentityLinks CreatorIdentityLink[] @relation("CreatorIdentityLinkTarget")

  @@unique([network, handleCanonical])
  @@index([network, status])
  @@index([handleHash])
}

model CreatorIdentityLink {
  id              String         @id @default(uuid())
  sourceCreatorId String
  targetCreatorId String
  evidence        Json
  status          String         @default("REVIEWED")
  reviewedBy      String
  reviewedAt      DateTime       @default(now())
  reviewReason    String
  createdAt       DateTime       @default(now())
  source          CreatorProfile @relation("CreatorIdentityLinkSource", fields: [sourceCreatorId], references: [id], onDelete: Cascade)
  target          CreatorProfile @relation("CreatorIdentityLinkTarget", fields: [targetCreatorId], references: [id], onDelete: Cascade)

  @@unique([sourceCreatorId, targetCreatorId])
  @@index([sourceCreatorId, status])
  @@index([targetCreatorId, status])
}

model CreatorRelationship {
  id                    String   @id @default(uuid())
  creatorId             String
  accountId             String
  personaRevisionId     String?
  stage                 String   @default("DISCOVERED")
  stageEvidence         Json
  sharedDomains         Json
  interactionCount      Int      @default(0)
  substantiveReplyCount Int      @default(0)
  reciprocalCount       Int      @default(0)
  lastInteractionAt     DateTime?
  cooldownUntil         DateTime?
  ownerNote             String?
  manualPriority        String?
  status                String   @default("ACTIVE")
  version               Int      @default(1)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  creator               CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  account               SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  personaRevision       PersonaRevision? @relation(fields: [personaRevisionId], references: [id], onDelete: SetNull)
  evidence              CreatorInteractionEvidence[]
  opportunities         CollaborationOpportunity[]

  @@unique([creatorId, accountId])
  @@index([accountId, stage, status])
  @@index([personaRevisionId, lastInteractionAt])
}

model CreatorInteractionEvidence {
  id             String   @id @default(uuid())
  relationshipId String
  interactionId  String?
  evidenceType   String
  sourceRef      Json
  evidenceHash   String
  weight         Float?
  occurredAt     DateTime
  expiresAt      DateTime?
  createdAt      DateTime @default(now())
  relationship   CreatorRelationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)

  @@unique([relationshipId, evidenceType, evidenceHash])
  @@index([relationshipId, occurredAt])
}

model CollaborationOpportunity {
  id                String   @id @default(uuid())
  relationshipId    String
  opportunityType   String
  topic             String
  rationale         Json
  risks             Json
  proposedAccountId String
  proposedPersonaId String?
  status            String   @default("PROPOSED")
  version           Int      @default(1)
  reviewedBy        String?
  outreachRef       Json?
  campaignRef       Json?
  validUntil        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  relationship      CreatorRelationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)

  @@index([status, validUntil])
  @@index([proposedAccountId, createdAt])
}

model Session {
  id              String         @id @default(uuid())
  accountId       String
  account         SocialAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  storageState    Json           // Playwright storageState (cookies, localStorage)
  status          SessionStatus  @default(ACTIVE)
  lastHealthCheck DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([accountId])
  @@index([status])
}

model GenerationRun {
  id            String                 @id @default(uuid())
  triggeredBy   GenerationTrigger
  sourceTopics  Json                   // array of topics from content-source
  status        GenerationRunStatus    @default(RUNNING)
  startedAt     DateTime               @default(now())
  completedAt   DateTime?
  posts         Post[]
  errorMessage  String?

  @@index([status])
  @@index([triggeredBy])
}

// ============================================================
// Topic — LLM-generated content topics (replaces CAP repo dependency)
// Generated by TopicGenerationService cron, consumed by DbContentReader.
// ============================================================

model Topic {
  id          String   @id @default(uuid())
  topic       String   @unique
  keywords    Json     // string[]
  facts       Json     // string[]
  category    String   @default("general")
  sourceType  String   @default("llm") // "llm" | "trending" | "manual"
  status      String   @default("active") // "active" | "used" | "archived"
  usedAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([category])
  @@index([createdAt])
}

// ============================================================
// Content sources — configurable input adapters for IContentPort
// ============================================================

model ContentSource {
  id          String   @id @default(uuid())
  sourceType  String   // "cap_file", "db", "rss", "api", "google_trends"
  name        String?
  enabled     Boolean  @default(true)
  priority    Int      @default(0)
  config      Json     // adapter-specific config (Record<string, unknown>)
  lastRunAt   DateTime?
  lastError   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([enabled])
  @@index([priority])
}

model PostThread {
  id         String       @id @default(uuid())
  accountId  String
  account    SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  status     PostStatus   @default(DRAFT)
  posts      Post[]
  createdAt  DateTime     @default(now())
  postedAt   DateTime?

  @@index([accountId])
  @@index([status])
}

// ============================================================
// Thread Progress — per-reply tracking for resumable threads (P0-H2)
// ============================================================

model ThreadProgress {
  id           String    @id @default(uuid())
  postId       String    // FK → Post (root post of the thread)
  replyPostId  String    // FK → Post (individual reply)
  position     Int       // threadPosition of the reply (1, 2, 3, ...)
  status       String    // PENDING | POSTED | FAILED
  postUrl      String?   // URL of the individual reply (if posted)
  attemptedAt  DateTime  @default(now())
  completedAt  DateTime?
  error        String?

  @@unique([postId, replyPostId])
  @@index([postId])
  @@index([status])
}

model Post {
  id               String           @id @default(uuid())
  generationRunId  String?
  generationRun    GenerationRun?   @relation(fields: [generationRunId], references: [id], onDelete: SetNull)
  accountId        String
  account          SocialAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  threadId         String?
  thread           PostThread?      @relation(fields: [threadId], references: [id], onDelete: SetNull)
  threadPosition   Int              @default(0) // 0 = root, 1+ = replies in thread
  network          SocialNetwork
  language         String           @default("en") // ISO 639-1: en, ru, uk, es, it
  content          String           // final post text
  sourceRef        Json?            // { type: 'brief'|'article'|'topic', path: '...', topic: '...' }
  sourcePath       String?          // extracted sourceRef.path for indexed queries
  status           PostStatus       @default(DRAFT)
  postUrl          String?          // URL after posting
  errorMessage     String?
  retryCount       Int              @default(0) // BullMQ retry count (0-3)
  llmMetadata      Json?            // { model, tokens, cost, promptVersion, angleType }
  media            Json?            // generated image metadata; text-only posts keep null
  simhash          String?          // Sprint L: precomputed SimHash for fast dedup
  // ── Syndication fields (Phase 0-1) ──
  contentType      ContentType      @default(SOCIAL_POST) // SOCIAL_POST | ARTICLE | ANSWER | PIN
  canonicalUrl     String?          // POSSE canonical URL (blog URL for articles)
  syndicatedUrls   Json?            // { [network: string]: string } — platform URLs after syndication
  judgeScores      Json?            // LLM-as-a-Judge scores { anti_ai_tone, hook_strength, factual_accuracy, ... }
  judgeRetried     Boolean          @default(false) // true if judge triggered a refine retry
  // ── Link attribution (ROADMAP_V2 Z4 — my_zodiac_ai/back attribution-links client) ──
  ctaUrl           String?          // final CTA URL in the post text (zodiac short link or direct UTM fallback)
  attributionLinkId String?         // AttributionLink.id in my_zodiac_ai/back (null = direct UTM fallback was used)
  attributionSlug  String?          // AttributionLink.slug (denormalized for funnel-report lookups)
  personaRevisionId String?
  personaRevision   PersonaRevision? @relation(fields: [personaRevisionId], references: [id], onDelete: SetNull)
  voiceMode         String?
  experimentAssignmentId String?
  createdAt        DateTime         @default(now())
  approvedAt       DateTime?
  postedAt         DateTime?
  metrics          PostMetrics[]    @relation("PostMetricsToPost")
  incomingComments IncomingComment[] @relation("PostIncomingComments") // Sprint Q: tracked comments for reply monitoring
  variants         PostVariant[]
  reviewDecisions  PostReviewDecision[]

  @@index([status])
  @@index([network])
  @@index([accountId])
  @@index([generationRunId])
  @@index([threadId])
  @@index([simhash])
  @@index([sourcePath, network])
  @@index([contentType])
  @@index([canonicalUrl])
  @@index([attributionSlug])
}

// Durable operator feedback. PostgreSQL is the product truth; Langfuse sync is
// asynchronous and must never roll back a valid review decision.
model PostReviewDecision {
  id                    String   @id @default(uuid())
  postId                String
  post                  Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  version               Int      @default(1)
  actorId               String?
  decision              String   // APPROVE_UNCHANGED | APPROVE_EDITED | REJECT
  reasonCodes           Json
  rubric                Json?
  comment               String?
  originalContentHash   String
  finalContentHash      String?
  normalizedEditDistance Float?
  generationRunId       String?
  langfuseTraceId       String?
  langfuseObservationId String?
  syncStatus            String   @default("PENDING")
  syncAttempts          Int      @default(0)
  lastSyncError         String?
  langfuseSyncedAt      DateTime?
  createdAt             DateTime @default(now())

  @@unique([postId, version])
  @@index([decision, createdAt])
  @@index([syncStatus, createdAt])
  @@index([langfuseTraceId])
}

// A/B testing: variants generated for a post and their real-world outcomes.
model PostVariant {
  id          String        @id @default(uuid())
  postId      String
  post        Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  network     SocialNetwork
  label       String        // e.g. 'a', 'b', 'base', 'default', 'custom'
  content     String        // variant text
  judgeScores Json?         // LLM-as-a-Judge scores from the generation run
  selected    Boolean       @default(false)
  postedAt    DateTime?
  metricsAt   DateTime?
  likes       Int?
  comments    Int?
  shares      Int?
  impressions Int?
  createdAt   DateTime      @default(now())

  @@index([postId, network])
  @@index([network, selected, postedAt])
}

// ============================================================
// Post Metrics — F6: engagement metrics scraping (likes, comments, shares)
// ============================================================

model PostMetrics {
  id          String   @id @default(uuid())
  postId      String
  post            Post            @relation("PostMetricsToPost", fields: [postId], references: [id], onDelete: Cascade)
  network     SocialNetwork
  likes       Int      @default(0)
  comments    Int      @default(0)
  shares      Int      @default(0)
  impressions Int?
  collectedAt DateTime @default(now())

  @@index([postId, collectedAt])
  @@index([network])
}

// ============================================================
// Engagement Models (Phase 2-3)
// ============================================================

model Interaction {
  id            String             @id @default(uuid())
  accountId     String
  account       SocialAccount      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type          InteractionType
  status        InteractionStatus  @default(PENDING)
  targetUrl     String?            // URL of the post being liked/commented/replied to
  targetHandle  String?            // handle of the account being followed/interacted with
  content       String?            // comment text (for COMMENT/REPLY)
  personaRevisionId String?
  voiceMode      String?
  intent         String?
  policyMode     String?
  suggestionId   String?            @unique
  suggestion     EngagementSuggestion? @relation("SuggestionInteraction", fields: [suggestionId], references: [id], onDelete: SetNull)
  errorMessage  String?
  screenshotPath String?           // screenshot for debugging
  browsingSessionId String?
  browsingSession  BrowsingSession? @relation(fields: [browsingSessionId], references: [id], onDelete: SetNull)
  createdAt     DateTime           @default(now())
  completedAt   DateTime?

  @@index([accountId])
  @@index([type])
  @@index([status])
  @@index([browsingSessionId])
  @@index([createdAt])
}

// ADR-008: every conversational reply/quote starts as a durable suggestion.
// Approval changes state only; execution remains separately authorized by
// POLICY-101 immediately before a network side effect.
model EngagementSuggestion {
  id                     String   @id @default(uuid())
  accountId              String
  account               SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  personaRevisionId      String
  personaRevision        PersonaRevision @relation(fields: [personaRevisionId], references: [id], onDelete: Restrict)
  network                SocialNetwork
  targetUrl              String
  targetAuthorHandleHash String?
  sourceSnapshotHash     String
  threadContextRef       Json?
  voiceMode              String
  intent                 String
  content                String
  claimTrace             Json?
  memoryTrace            Json?
  judgeScores            Json?
  policyMode             String
  status                 String   @default("PROPOSED")
  version                Int      @default(1)
  reviewedBy             String?
  reviewedAt             DateTime?
  executedInteractionId  String?
  expiresAt              DateTime
  createdAt              DateTime @default(now())
  executedInteraction    Interaction? @relation("SuggestionInteraction")

  @@index([accountId, status, createdAt])
  @@index([personaRevisionId, createdAt])
  @@index([network, status])
}

/// Sprint Q / F4: Incoming comments on our posts, tracked for automated reply monitoring.
/// Conversation threads: nested replies are linked via parentId and grouped by conversationId (root commentId).
model IncomingComment {
  id                String           @id @default(uuid())
  postId            String
  post              Post             @relation("PostIncomingComments", fields: [postId], references: [id], onDelete: Cascade)
  network           SocialNetwork
  commentId         String           // platform-specific comment ID (for dedup)
  author            String
  text              String
  authorProfileUrl  String?
  commentUrl        String?          // platform permalink of this comment/tweet
  parentId          String?          // DB id of parent comment (nested reply)
  parent            IncomingComment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  children          IncomingComment[] @relation("CommentReplies")
  conversationId    String?          // root commentId of the conversation thread
  depth             Int              @default(0) // number of agent replies in this chain
  isQuestion        Boolean          @default(false)
  questionConfidence Float?          // classifier confidence 0..1
  questionType      String?          // factual | opinion | personal | offtopic
  replyUrl          String?          // URL of our posted reply on the platform (for nested reply scraping)
  status            CommentStatus    @default(NEW)
  replyText         String?          // generated reply (if any)
  replyPostedAt     DateTime?
  needsHumanReview  Boolean          @default(false) // true for complex/sensitive comments
  humanReviewReason String?         // why human review is needed
  scrapedAt         DateTime         @default(now())
  createdAt         DateTime         @default(now())

  @@unique([postId, commentId]) // dedup: one record per (post, comment)
  @@index([postId])
  @@index([status])
  @@index([network])
  @@index([scrapedAt])
  @@index([conversationId, depth])
  @@index([parentId])
}

enum CommentStatus {
  NEW            // just scraped, not yet processed
  REPLIED        // reply posted automatically
  SKIPPED        // decided not to reply (spam, self, etc.)
  HUMAN_REVIEW   // needs human review (complex, sensitive)
  REPLIED_MANUAL // human reviewed and replied manually
}

model BrowsingSession {
  id              String               @id @default(uuid())
  accountId       String
  account         SocialAccount        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  status          BrowsingSessionStatus @default(ACTIVE)
  startedAt       DateTime             @default(now())
  endedAt         DateTime?
  durationSec     Int                  @default(0)
  postsViewed     Int                  @default(0)
  interactionsCount Int                @default(0)
  feedUrl         String?              // which feed was browsed
  errorMessage    String?
  interactions    Interaction[]

  @@index([accountId])
  @@index([status])
  @@index([startedAt])
}

// ============================================================
// Admin — UI authentication (JWT in httpOnly cookie)
// Single admin account, bootstrapped from ADMIN_USERNAME/ADMIN_PASSWORD env vars.
// Password hashed with Node.js crypto.scrypt (no external deps).
// ============================================================

model Admin {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String   // scrypt hash: "saltHex:hashHex"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
