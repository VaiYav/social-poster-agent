# SPA Backend — NestJS API + BullMQ worker
# Multi-stage build: build TypeScript → slim production image

FROM node:24-slim AS builder

WORKDIR /app

# Node 24 slim no longer ships Corepack.
RUN npm install --global pnpm@11.21.0

# Copy workspace config
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/backend/package.json ./packages/backend/
# REFACTOR-100: schema must exist BEFORE install — backend postinstall runs
# `prisma generate`, which fails without it (alignment with root Dockerfile).
COPY packages/backend/prisma ./packages/backend/prisma

# Install dependencies
RUN pnpm install --frozen-lockfile

# Pre-fetch Camoufox browser binary so production does not download it at runtime.
ENV CAMOUFOX_INSTALL_DIR=/app/.cache/camoufox
RUN npx camoufox-js fetch

# Copy source
COPY packages/shared/ ./packages/shared/
COPY packages/backend/ ./packages/backend/

# Patch Playwright coreBundle.js — Camoufox/Juggler uncaughtError crash (camoufox#635).
# Must run AFTER pnpm install so coreBundle.js exists. Idempotent.
RUN node packages/backend/scripts/patch-playwright.js

# Build shared package first
RUN pnpm --filter @spa/shared build

# Build backend
# REFACTOR-100: filter must match the package NAME (@spa/backend); the previous
# bare `backend` selector matches no project.
RUN pnpm --filter @spa/backend build

# Generate Prisma client
RUN cd packages/backend && npx prisma generate

# Copy generated .prisma (client code + engine) to a known location for the
# production stage — same technique as the root Dockerfile.
RUN PRISMA_DIR=$(find /app/node_modules/.pnpm -maxdepth 4 -name '.prisma' -type d | head -1) && \
    cp -r "$PRISMA_DIR" /tmp/.prisma

# ── Production stage ──
FROM node:24-slim AS production

WORKDIR /app

RUN npm install --global pnpm@11.21.0

# Install Chromium dependencies for Camoufox/Playwright
# unzip + curl: needed if Camoufox needs to be downloaded at runtime (AdmZip fallback)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgtk-3-0 libasound2 libdbus-glib-1-2 libx11-xcb1 \
    libxcomposite1 libxdamage1 libxrandr2 libxss1 \
    libxtst6 libpango-1.0-0 libcairo2 libatk1.0-0 \
    libatk-bridge2.0-0 libnss3 libnspr4 \
    unzip curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/backend/package.json ./packages/backend/

# REFACTOR-100: --ignore-scripts, same as the root Dockerfile — the backend
# postinstall (prisma generate + playwright patch) needs devDependencies that a
# --prod install does not contain. Both steps are done explicitly below.
RUN pnpm install --frozen-lockfile --prod --ignore-scripts

# Copy the Playwright patch script (needed before patching coreBundle.js)
COPY packages/backend/scripts/patch-playwright.js ./packages/backend/scripts/patch-playwright.js

# Patch Playwright coreBundle.js — Camoufox/Juggler uncaughtError crash (camoufox#635).
RUN node packages/backend/scripts/patch-playwright.js

# Copy pre-fetched Camoufox browser binary and make it writable for the spa user.
ENV CAMOUFOX_INSTALL_DIR=/app/.cache/camoufox
COPY --from=builder /app/.cache/camoufox /app/.cache/camoufox

# Copy built artifacts
COPY --from=builder /app/packages/shared/dist ./packages/shared/dist
COPY --from=builder /app/packages/backend/dist ./packages/backend/dist
COPY --from=builder /app/packages/backend/prisma ./packages/backend/prisma

# Copy generated Prisma client from builder to the correct pnpm store path.
# REFACTOR-100: aligned with the root Dockerfile — copy the generated `.prisma`
# output (client code + query engine) from a known /tmp location prepared in the
# builder. This must run before USER spa (needs root to write to node_modules).
COPY --from=builder /app/node_modules/.pnpm/@prisma+client*/node_modules/@prisma/client /tmp/prisma-generated
RUN CLIENT_NM_DIR=$(find /app/node_modules/.pnpm -maxdepth 4 -path '*/@prisma+client*/node_modules' -type d | head -1) && \
    cp -r /tmp/prisma-generated/* "$CLIENT_NM_DIR/" && \
    cp -r /tmp/.prisma "$CLIENT_NM_DIR/" && \
    rm -rf /tmp/prisma-generated /tmp/.prisma

# Copy brand voice
COPY brand-voice.md ./

# SEC2: persistent browser profiles must live on a writable, non-world-readable dir.
# Camoufox stores FB/Threads cookies here (plaintext outside DB encryption). /tmp
# is broadly accessible; in production mount an encrypted/restricted volume here.
RUN mkdir -p /app/profiles && chmod 700 /app/profiles

# Sprint N: Add non-root user for security
RUN groupadd -r spa && useradd -r -g spa spa && chown -R spa:spa /app
USER spa

EXPOSE 3100

# MEM: constrain Node heap to leave headroom for Camoufox processes in the 2G container.
ENV NODE_OPTIONS=--max-old-space-size=1536

# Sprint N: Healthcheck — verify the API is responding.
# Uses node (always available in the image) with built-in fetch.
# The health endpoint is at /api/v1/health (setGlobalPrefix in main.ts).
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD node -e "fetch('http://localhost:3100/api/v1/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))" || exit 1

ENV NODE_ENV=production
ENV SPA_API_PORT=3100

# Run prisma migrate deploy on startup, then start the app
CMD npx prisma migrate deploy --schema packages/backend/prisma/schema.prisma && node packages/backend/dist/main.js
