{
  "name": "social-poster-agent",
  "version": "0.5.2",
  "license": "Apache-2.0",
  "private": true,
  "description": "AI-assisted multi-network social posting system",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @spa/backend dev",
    "dev:ui": "pnpm --filter @spa/ui dev",
    "dev:all": "concurrently -n backend,ui -c blue,green \"pnpm dev\" \"pnpm dev:ui\"",
    "build": "pnpm --filter @spa/shared build && pnpm --filter @spa/backend build && pnpm --filter @spa/ui build && pnpm sentry:sourcemaps",
    "build:backend": "pnpm --filter @spa/shared build && pnpm --filter @spa/backend build",
    "build:ui": "pnpm --filter @spa/shared build && pnpm --filter @spa/ui build",
    "lint": "oxlint .",
    "format": "oxfmt '**/*.ts' '**/*.vue'",
    "format:check": "oxfmt --check '**/*.ts' '**/*.vue'",
    "format:write": "oxfmt --write '**/*.ts' '**/*.vue'",
    "test": "pnpm --filter @spa/backend test",
    "test:watch": "pnpm --filter @spa/backend test:watch",
    "test:unit": "pnpm --filter @spa/backend test:unit && pnpm --filter @spa/ui test",
    "test:integration": "pnpm --filter @spa/backend test:integration",
    "test:system": "pnpm --filter @spa/backend test:system",
    "test:acceptance": "pnpm --filter @spa/backend test:acceptance",
    "test:e2e": "pnpm --filter @spa/backend test:e2e",
    "test:ui-e2e": "pnpm --filter @spa/ui test:e2e",
    "test:all": "pnpm test:unit && pnpm test:integration && pnpm test:system && pnpm test:acceptance && pnpm test:ui-e2e",
    "test:coverage": "pnpm --filter @spa/backend test:coverage",
    "prisma:migrate": "pnpm --filter @spa/backend prisma:migrate",
    "prisma:generate": "pnpm --filter @spa/backend prisma:generate",
    "prisma:studio": "pnpm --filter @spa/backend prisma:studio",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "dry-run": "pnpm --filter @spa/backend dry-run",
    "sentry:sourcemaps": "if [ -z \"$SENTRY_PROJECT\" ]; then echo 'Sentry sourcemap upload skipped (SENTRY_PROJECT not set)'; else sentry-cli sourcemaps inject ./packages/backend/dist/ && sentry-cli sourcemaps upload ./packages/backend/dist/; fi"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": ">=11.0.0"
  },
  "dependencies": {
    "@sentry/cli": "^3.6.2"
  },
  "packageManager": "pnpm@11.21.0"
}
